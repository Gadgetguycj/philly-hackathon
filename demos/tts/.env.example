# Required. A RunPod API key with access to the public endpoints.
RUNPOD_API_KEY=
# The RunPod public endpoint id. A full base URL also works, which is how you
# point the app at a local stand-in instead of api.runpod.ai.
TTS_ENDPOINT=chatterbox-turbo
# Words allowed in one run, counted after trimming, split on whitespace.
MAX_WORDS=2000
# The public origin of this app. Voice cloning stays off until this is set,
# because RunPod has to fetch the uploaded clip over the internet.
PUBLIC_BASE_URL=
# Where audio, previews and clone clips are written.
DATA_DIR=/data
