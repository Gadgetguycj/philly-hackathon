# The bearer token for the endpoint. Required.
RUNPOD_API_KEY=
# Any OpenAI compatible base URL. The default is RunPod's public Kimi endpoint.
LLM_BASE_URL=https://api.runpod.ai/v2/moonshot-kimi/openai/v1
LLM_MODEL=kimi-k2.6
# Extra top level fields for every chat completions request, as one JSON object.
# Empty by default. A reasoning model needs the field that turns its thinking off, or it
# spends the whole token budget thinking and sends back no text.
# RunPod's Kimi:   LLM_EXTRA={"thinking":{"type":"disabled"},"temperature":0.6}
#   That endpoint returns an empty 200 for any temperature but 0.6, so pin it here.
# gpt-oss on vLLM: LLM_EXTRA={"reasoning_effort":"low"}
LLM_EXTRA=
# The page count the selector starts on.
BOOK_PAGES=30
DATA_DIR=/data
